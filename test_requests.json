          "crop_age_days": 25
        },
        "history": []
      }
    },
    {
      "name": "Chat - Out of Scope Fallback Test",
      "method": "POST",
      "endpoint": "/api/chat",
      "body": {
        "query": "كيف أزرع أشجار البن في القطب المتجمد الشمالي؟",
        "farmer_context": {
          "farmer_name": "سعيد",
          "crop": "بن"
        }
      }
    },
    {
      "name": "Ingest Documents (Manual Trigger)",
      "method": "POST",
      "endpoint": "/api/ingest",
      "body": {
        "force_reindex": false
      }
    }
  ]
}
