        "farmer_context": {
          "farmer_name": "الحاج أحمد",
          "crop": "بنجر السكر",
          "soil_type": "طينية",
          "irrigation_system": "ري بالغمر",
          "governorate": "كفر الشيخ",
          "crop_age_days": 35
        },
        "history": []
      }
    },
    {
      "name": "Chat - Wheat Fertilizer Query (تسميد القمح)",
      "method": "POST",
      "endpoint": "/api/chat",
      "body": {
        "query": "ما هي كمية السماد المطلوبة لري المحاياة في القمح؟",
        "farmer_context": {
          "farmer_name": "عبدالرحمن",
          "crop": "قمح",
